# Copy this file to .env and fill in values.

# Leave WHATSAPP_GROUP_ID empty at first. On startup, every incoming chat ID
# will be logged to the console. Send a message in your target group, copy
# its ID from the console, paste it below, then restart the bot.
WHATSAPP_GROUP_ID=

# Port for the minimal keepalive HTTP server (pinged by the cron job in
# render.yaml, or an external pinger like cron-job.org, to keep Render's
# free-tier web service from spinning down — see README.md "Deploying to
# Render").
PORT=3000

# OpenRouter API key, used only as a fallback when the regex parser can't
# confidently extract an amount and recipient from a message. Get one at
# https://openrouter.ai/keys
LLM_API_KEY=

# Google Sheets Service Account credentials (Phase 5 — Sheets Writer).
# Create these via a Google Cloud project: enable the Sheets API, create a
# Service Account, download its JSON key, then share your target Google
# Sheet with the service account's email (Editor access).
#
# GOOGLE_SERVICE_ACCOUNT_EMAIL is the "client_email" field from the JSON key.
GOOGLE_SERVICE_ACCOUNT_EMAIL=

# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY is the "private_key" field from the JSON
# key, pasted as a single line with literal \n sequences kept intact (the app
# converts them back to real newlines) — most editors will preserve this if
# you paste the JSON value directly, e.g.:
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIExampleKeyContentHere...\n-----END PRIVATE KEY-----\n"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# The target spreadsheet's ID — the long string in its URL between
# /d/ and /edit, e.g. https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=

# IANA timezone the sheet's approved_at/rejected_at column is rendered in.
# Defaults to Asia/Kolkata (this project's currency/sample data are
# India-context) if unset — override for a different region.
SHEET_TIMEZONE=

# Phase 7 — Hardening & Deployment.

# A WhatsApp number/JID (e.g. 91xxxxxxxxxx@s.whatsapp.net) used ONLY for
# critical connectivity alerts (the bot has been offline for longer than
# OFFLINE_ALERT_THRESHOLD_MINUTES). Never used for ledger confirmations,
# approvals, or any other message type. Leave empty to disable WhatsApp
# alerts — offline events are still always logged locally either way.
BOT_ADMIN_FALLBACK_NUMBER=

# Redis connection string (e.g. from Upstash's free tier), used to store
# Baileys' session (auth) state instead of local disk — needed on hosts
# without a persistent disk (Render's free tier, per architecture.md §2a).
# Leave empty to keep using local-disk auth state (./auth), the default and
# the right choice for any host with a persistent disk (e.g. an Oracle
# Cloud "Always Free" VM).
REDIS_URL=

# How many minutes of continuous WhatsApp disconnection before the bot logs
# an offline alert and (once reconnected) sends a recovery notice to
# BOT_ADMIN_FALLBACK_NUMBER. Defaults to 10 if unset.
OFFLINE_ALERT_THRESHOLD_MINUTES=10

# --- v1.1: LLM normalization layer (all optional; layer is inert if unset/off) ---
# See doc/prd.md §10 and doc/trd.md §8 for the full design.

# off | shadow | on. Defaults to "off" — v1.0 behavior unchanged, no network
# calls made by this layer at all. "shadow" calls the LLM in the background
# and logs what it would have done, without ever delaying or altering the
# live message handling. "on" actually reformats entries before approval.
NORMALIZER_MODE=off

# OpenRouter API key for the normalization layer specifically. Get one at
# https://openrouter.ai/keys. Distinct from LLM_API_KEY above (that one is
# the v1.0 parser's fallback) so either layer's key can be rotated/disabled
# independently.
OPENROUTER_API_KEY=

# Primary model slug, e.g. "anthropic/claude-haiku-4.5". Pick after testing
# a few candidates against a sample of messy messages — see
# openrouter.ai/models.
OPENROUTER_MODEL=

# Optional second model slug OpenRouter falls back to if the primary is
# unavailable/rate-limited. Leave empty to use only OPENROUTER_MODEL.
OPENROUTER_FALLBACK_MODEL=

# Per-request timeout in milliseconds. Defaults to 8000 if unset.
NORMALIZER_TIMEOUT_MS=8000

# Minimum confidence (0-1) the LLM must report for its own output before it
# is trusted; below this, the message gets a clarification reply instead of
# being recorded. Defaults to 0.7 if unset.
NORMALIZER_MIN_CONFIDENCE=0.7

# How many consecutive normalizer failures (timeouts, bad responses, etc.)
# before alerting BOT_ADMIN_FALLBACK_NUMBER once (resets on the next
# success). Defaults to 5 if unset.
NORMALIZER_ALERT_AFTER_FAILURES=5

# v1.2 — only consulted when QUEUE_ENABLED=true (replaces the plain
# fail-open rule above for the queue path). hold | passthrough. Defaults
# to "hold": if the LLM is unreachable/blocked (timeout, 5xx, 429, 401,
# 402), the job is rescheduled WITHOUT counting an attempt, so no
# "please rephrase" message is ever sent just because the LLM was down.
# "passthrough" gives the immediate v1.0 fail-open behavior instead.
NORMALIZER_ON_LLM_DOWN=hold

# How many minutes (measured from the WhatsApp message's own timestamp,
# not processing time) to keep holding before falling back to the v1.0
# parsed entry unnormalized. Defaults to 10. If the v1.0 parser ALSO
# found nothing usable, holding continues until QUEUE_MAX_AGE_HOURS
# regardless of this value.
NORMALIZER_MAX_HOLD_MINUTES=10

# Optional comma-separated list of valid party names (e.g.
# "Bride's side,Groom's side") the normalizer may tag an entry with. If the
# LLM names a party outside this list, it's cleared rather than trusted.
# Leave empty if this event doesn't use the party concept.
ALLOWED_PARTIES=

# --- v1.2: Durable job queue (all optional; layer is inert if unset/false) ---
# See doc/trd.md's v1.2 addendum for the full design. With QUEUE_ENABLED=false
# (the default), no Redis client for the queue is ever constructed and every
# inbound message is handled exactly as in v1.0/v1.1 — synchronously, with no
# durability layer in front of it.

# true | false. Defaults to "false" — v1.0/v1.1 behavior unchanged. When
# "true", REDIS_URL (below) is required; inbound messages, sheet writes, and
# WhatsApp replies are all processed through a Redis-backed durable queue
# instead of inline, so a crash/restart/outage mid-message never loses or
# duplicates an expense.
QUEUE_ENABLED=false

# Reuses the same REDIS_URL already configured above for Baileys auth state
# (a separate Redis client is constructed against the same URL — see
# src/queue/setup.js). Required when QUEUE_ENABLED=true. Use a rediss://
# (TLS) URL, e.g. from Upstash's free tier — queue contents are treated as
# sensitive, same as the auth-state connection.

# How many jobs the queue processes at once. Defaults to 2 if unset — kept
# small so a wedding-scale message volume never needs more.
QUEUE_CONCURRENCY=2

# How long (seconds) a claimed job's lease lasts before a crashed/frozen
# worker's job is reclaimed by another claim cycle. Defaults to 120.
QUEUE_LEASE_SECONDS=120

# How often (seconds) the queue's recovery sweeper runs (reclaims expired
# leases, retries a Redis-outage buffer drain). This is a slow recovery net,
# not the normal-path scheduling mechanism (that's event-driven). Defaults
# to 60.
QUEUE_SWEEP_INTERVAL_SECONDS=60

# How many hours a job may keep retrying on transient failures before it is
# dead-lettered. Defaults to 72.
QUEUE_MAX_AGE_HOURS=72

# Minutes the oldest ready/inflight job may sit before an admin alert fires
# (via BOT_ADMIN_FALLBACK_NUMBER). Defaults to 15.
QUEUE_ALERT_OLDEST_MINUTES=15

# redis | file. Defaults to "file" — the exact pre-v1.2 behavior (pending
# approvals stored in ./data/pending-store.json). Only meaningful once
# QUEUE_ENABLED=true; set to "redis" on hosts with no persistent disk
# (Render free tier) so a redeploy/restart never loses an in-flight
# approval. Reuses the same REDIS_URL/queue Redis client — no separate
# connection is made.
STATE_STORE=file
